NODE_ENV=development
PORT=8000
# Comma-separated list of allowed frontend origins (no "*"; admin API uses credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Must include an explicit database name after the host, e.g. .../vridhio?retryWrites=true
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/<db-name>?retryWrites=true&w=majority

# At least 32 characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=

# Lead Finder
# Searches use built-in test data by default. Admins can choose "Real Apify" per search in the
# UI; the server accepts that only when APIFY_ENABLED=true and the Apify settings below are complete.
# Set to false to run the worker only via `npm run worker`
LEAD_FINDER_WORKER_ENABLED=true
# Simulated discovery delay for the fake provider (ms)
FAKE_PROVIDER_LATENCY_MS=1500
# Hard limit for one discovery call, whatever the provider (ms, default 480000)
# LEAD_FINDER_PROVIDER_TIMEOUT_MS=480000

# Apify business discovery (server-side only; never expose to the frontend or a VITE_ variable)
APIFY_ENABLED=false
APIFY_TOKEN=
# Actor to run, e.g. "<username>/<actor-name>". Must match APIFY_ACTOR_ADAPTER's input/output contract.
APIFY_ACTOR_ID=
# Input/output adapter for the Actor (default: google-maps)
# APIFY_ACTOR_ADAPTER=google-maps
# Actor run timeout in seconds (default 300)
# APIFY_TIMEOUT_SECONDS=300
# Max dataset items per run; capped at the app limit of 100 (default 100)
# APIFY_MAX_ITEMS=100
# Spending cap per run in USD for pay-per-event Actors (default 1)
# APIFY_MAX_TOTAL_CHARGE_USD=1
# Seconds between run status checks (default 5)
# APIFY_POLL_INTERVAL_SECONDS=5

# Discovery spending limits for paid providers, per UTC day / UTC month (USD).
# A search is refused before it starts if today's spend plus its spending cap would exceed the limit.
# Daily default 5; set "off" to disable. Monthly is off unless set.
# LEAD_FINDER_DAILY_BUDGET_USD=5
# LEAD_FINDER_MONTHLY_BUDGET_USD=
# Search centres for radius filtering are resolved via OpenStreetMap Nominatim (free, ~1 request/second).
# Set to false to accept only "lat, lng" coordinates as the location for live searches.
# LEAD_FINDER_GEOCODING_ENABLED=true

# AI qualification (server-side only; never expose to the frontend or a VITE_ variable)
# Paid AI is off unless OPENAI_ENABLED=true. A key on its own never enables it.
OPENAI_ENABLED=false
OPENAI_API_KEY=
# Default gpt-4o-mini. Any other model also needs both price variables below.
# OPENAI_MODEL=gpt-4o-mini
# USD per 1M tokens, used to price reported token usage (defaults only for gpt-4o-mini: 0.15 / 0.60)
# OPENAI_INPUT_PRICE_PER_MTOK_USD=0.15
# OPENAI_OUTPUT_PRICE_PER_MTOK_USD=0.60
# Max output tokens per qualification (default 1200, max 4000)
# OPENAI_MAX_OUTPUT_TOKENS=1200
# Request timeout in ms (default 30000, max 120000)
# OPENAI_TIMEOUT_MS=30000
# NVIDIA NIM (OpenAI-compatible). Off unless NVIDIA_ENABLED=true, also when selected below.
NVIDIA_ENABLED=false
NVIDIA_API_KEY=
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=openai/gpt-oss-20b
# Max output tokens incl. reasoning (default 4000, max 8000); timeout in ms (default 60000, max 120000)
# NVIDIA_MAX_OUTPUT_TOKENS=4000
# NVIDIA_TIMEOUT_MS=60000
# Optional USD per 1M tokens. Unset = cost recorded as unknown (never $0) and not counted in the budgets.
# NVIDIA_INPUT_PRICE_PER_MTOK_USD=
# NVIDIA_OUTPUT_PRICE_PER_MTOK_USD=
# Optional explicit provider: "fake", "openai" or "nvidia". Required if both OPENAI_ENABLED
# and NVIDIA_ENABLED are true. "fake" is a free deterministic test provider.
# QUALIFICATION_PROVIDER=fake
# Set to false to run qualifications only via `npm run worker:qualification`
# QUALIFICATION_WORKER_ENABLED=true
# Days a completed qualification is reused before a new one is needed (default 7)
# QUALIFICATION_FRESH_DAYS=7
# AI spending limits per UTC day / UTC month (USD). Defaults 1 and 10; set "off" to disable.
LEAD_FINDER_AI_DAILY_BUDGET_USD=1
LEAD_FINDER_AI_MONTHLY_BUDGET_USD=10

# Website analysis (free: direct HTTP checks, no paid APIs). Lead Finder queues one for every
# business it saves; set to false to analyse only when an admin clicks Analyze.
# WEBSITE_ANALYSIS_AUTO=true
